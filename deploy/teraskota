# 1. System & Website Info
show_info() {
    show_banner

    # System Metrics
    HOSTNAME=$(hostname 2>/dev/null || echo "vps")
    OS_NAME=$(grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"' || uname -s)
    ARCH=$(uname -m)
    UPTIME_STR=$(uptime -p 2>/dev/null || uptime | awk -F'( |,|:)+' '{print $6,"hrs"}')
    CPU_LOAD=$(awk '{print $1", "$2", "$3}' /proc/loadavg 2>/dev/null || echo "N/A")

    # RAM and SWAP calculation
    RAM_TOTAL=$(free -m | awk '/^Mem:/{print $2}')
    RAM_USED=$(free -m | awk '/^Mem:/{print $3}')
    RAM_PCT=$(( RAM_USED * 100 / (RAM_TOTAL > 0 ? RAM_TOTAL : 1) ))

    SWAP_TOTAL=$(free -m | awk '/^Swap:/{print $2}')
    SWAP_USED=$(free -m | awk '/^Swap:/{print $3}')
    SWAP_PCT=0
    if [ "$SWAP_TOTAL" -gt 0 ]; then
        SWAP_PCT=$(( SWAP_USED * 100 / SWAP_TOTAL ))
    fi

    # Disk metrics for /
    DISK_TOTAL=$(df -h / | awk 'NR==2{print $2}')
    DISK_USED=$(df -h / | awk 'NR==2{print $3}')
    DISK_PCT=$(df -h / | awk 'NR==2{print $5}')

    # Service Statuses
    NGINX_STAT=$(systemctl is-active nginx 2>/dev/null || echo "unknown")
    PHP_STAT=$(systemctl is-active "$PHP_FPM_SVC" 2>/dev/null || echo "unknown")
    DB_STAT=$(systemctl is-active "$DB_SVC" 2>/dev/null || echo "unknown")

    format_status() {
        if [ "$1" = "active" ]; then
            echo -e "${C_GREEN}● ACTIVE${C_RESET}"
        else
            echo -e "${C_RED}● INACTIVE ($1)${C_RESET}"
        fi
    }

    # Domain & SSL Info
    CURRENT_DOMAIN="Belum diatur"
    if [ -f "$ENV_FILE" ]; then
        APP_URL=$(grep -E '^APP_URL=' "$ENV_FILE" | cut -d= -f2- | tr -d '"' | tr -d "'")
        CURRENT_DOMAIN="${APP_URL:-Belum diatur}"
    fi

    SSL_STATUS="Belum Terpasang (HTTP)"
    DOMAIN_NAME=$(echo "$CURRENT_DOMAIN" | sed -e 's|^[^/]*//||' -e 's|/.*$||' -e 's|:.*$||')
    if [ -d "/etc/letsencrypt/live/$DOMAIN_NAME" ]; then
        EXP_DATE=$(openssl x509 -enddate -noout -in "/etc/letsencrypt/live/$DOMAIN_NAME/cert.pem" 2>/dev/null | cut -d= -f2)
        if [ -n "$EXP_DATE" ]; then
            SSL_STATUS="${C_GREEN}Aktif (Exp: $EXP_DATE)${C_RESET}"
        else
            SSL_STATUS="${C_GREEN}Aktif (Let's Encrypt)${C_RESET}"
        fi
    fi

    # Git version info
    GIT_COMMIT="N/A"
    GIT_BRANCH="N/A"
    if [ -d "$APP_DIR/.git" ] && command -v git &>/dev/null; then
        GIT_COMMIT=$(git -C "$APP_DIR" rev-parse --short HEAD 2>/dev/null || echo "N/A")
        GIT_BRANCH=$(git -C "$APP_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "N/A")
    fi

    # Maintenance mode check
    MAINT_STATUS="${C_GREEN}Online (Normal)${C_RESET}"
    if [ -f "$APP_DIR/storage/framework/down" ]; then
        MAINT_STATUS="${C_YELLOW}Maintenance Mode ON${C_RESET}"
    fi

    echo -e "${C_BOLD}SISTEM & SPESIFIKASI:${C_RESET}"
    echo -e "  Host / OS       : ${C_WHITE}$HOSTNAME ($OS_NAME - $ARCH)${C_RESET}"
    echo -e "  Uptime / Load   : ${C_WHITE}$UPTIME_STR | Load: $CPU_LOAD${C_RESET}"
    echo -e "  RAM Usage       : ${C_WHITE}${RAM_USED} MB / ${RAM_TOTAL} MB (${RAM_PCT}%)${C_RESET}"
    echo -e "  SWAP Usage      : ${C_WHITE}${SWAP_USED} MB / ${SWAP_TOTAL} MB (${SWAP_PCT}%)${C_RESET}"
    echo -e "  Penyimpanan     : ${C_WHITE}${DISK_USED} / ${DISK_TOTAL} (${DISK_PCT})${C_RESET}"
    echo ""
    echo -e "${C_BOLD}STATUS LAYANAN SERVER:${C_RESET}"
    echo -e "  Web Server      : Nginx [$(format_status "$NGINX_STAT")]"
    echo -e "  PHP FastCGI     : $PHP_FPM_SVC [$(format_status "$PHP_STAT")]"
    echo -e "  Database        : $DB_SVC [$(format_status "$DB_STAT")]"
    echo ""
    echo -e "${C_BOLD}APLIKASI & DOMAIN:${C_RESET}"
    echo -e "  Alamat URL/Domain: ${C_CYAN}$CURRENT_DOMAIN${C_RESET}"
    echo -e "  Sertifikat SSL  : $SSL_STATUS"
    echo -e "  Status Website  : $MAINT_STATUS"
    echo -e "  Git Version     : ${C_WHITE}branch '$GIT_BRANCH' ($GIT_COMMIT)${C_RESET}"
    echo "================================================================================"
}

# 2. Service Management
manage_services() {
    show_banner
    echo -e "${C_BOLD}MANAJEMEN LAYANAN SERVER:${C_RESET}"
    echo "  1) Restart Semua Layanan (Nginx + PHP-FPM + Database)"
    echo "  2) Restart Nginx Web Server"
    echo "  3) Restart PHP-FPM Engine"
    echo "  4) Restart Database Server ($DB_SVC)"
    echo "  5) Stop Semua Layanan"
    echo "  6) Start Semua Layanan"
    echo "  7) Lihat Status Lengkap (systemctl status)"
    echo "  0) Kembali ke Menu Utama"
    echo ""
    read -rp "Pilih aksi [0-7]: " s_choice

    case "$s_choice" in
        1)
            echo -e "${C_YELLOW}Merestart seluruh layanan...${C_RESET}"
            systemctl restart nginx "$PHP_FPM_SVC" "$DB_SVC"
            echo -e "${C_GREEN}Semua layanan berhasil direstart!${C_RESET}"
            ;;
        2)
            systemctl restart nginx && echo -e "${C_GREEN}Nginx direstart.${C_RESET}"
            ;;
        3)
            systemctl restart "$PHP_FPM_SVC" && echo -e "${C_GREEN}$PHP_FPM_SVC direstart.${C_RESET}"
            ;;
        4)
            systemctl restart "$DB_SVC" && echo -e "${C_GREEN}$DB_SVC direstart.${C_RESET}"
            ;;
        5)
            systemctl stop nginx "$PHP_FPM_SVC" "$DB_SVC" && echo -e "${C_RED}Semua layanan dimatikan.${C_RESET}"
            ;;
        6)
            systemctl start "$DB_SVC" "$PHP_FPM_SVC" nginx && echo -e "${C_GREEN}Semua layanan dinyalakan.${C_RESET}"
            ;;
        7)
            systemctl status nginx "$PHP_FPM_SVC" "$DB_SVC" --no-pager
            ;;
        *)
            return
            ;;
    esac
    read -rp "Tekan Enter untuk melanjutkan..."
}

# 3. Change Domain
change_domain() {
    show_banner
    echo -e "${C_BOLD}UBAH NAMA DOMAIN WEBSITE:${C_RESET}"
    echo ""
    CURRENT_DOMAIN=$(grep -E '^APP_URL=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- | tr -d '"' | tr -d "'" || echo "")
    echo -e "Domain saat ini: ${C_CYAN}${CURRENT_DOMAIN:-Belum ada}${C_RESET}"
    echo ""
    read -rp "Masukkan nama domain/subdomain baru (misal: pos.teraskota.com): " NEW_DOMAIN
    NEW_DOMAIN=$(echo "$NEW_DOMAIN" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

    if [ -z "$NEW_DOMAIN" ]; then
        echo -e "${C_RED}Nama domain tidak boleh kosong.${C_RESET}"
        read -rp "Tekan Enter untuk melanjutkan..."
        return
    fi

    # Update Nginx Configuration
    if [ -f "$NGINX_CONF" ]; then
        sed -i -E "s/server_name [^;]+;/server_name $NEW_DOMAIN;/g" "$NGINX_CONF"
        if nginx -t; then
            systemctl reload nginx
            echo -e "${C_GREEN}Konfigurasi Nginx berhasil diperbarui untuk domain $NEW_DOMAIN.${C_RESET}"
        else
            echo -e "${C_RED}Error pada konfigurasi Nginx! Mengembalikan perubahan.${C_RESET}"
        fi
    fi

    # Update .env APP_URL
    if [ -f "$ENV_FILE" ]; then
        PROTOCOL="http"
        if [ -d "/etc/letsencrypt/live/$NEW_DOMAIN" ]; then
            PROTOCOL="https"
        fi
        sed -i -E "s|^APP_URL=.*|APP_URL=$PROTOCOL://$NEW_DOMAIN|" "$ENV_FILE"
        php "$APP_DIR/artisan" config:clear >/dev/null 2>&1 || true
        echo -e "${C_GREEN}.env APP_URL diperbarui menjadi $PROTOCOL://$NEW_DOMAIN.${C_RESET}"
    fi

    echo ""
    read -rp "Apakah Anda ingin langsung memasang SSL HTTPS (Let's Encrypt) untuk $NEW_DOMAIN sekarang? (y/n): " want_ssl
    if [[ "$want_ssl" =~ ^[Yy]$ ]]; then
        setup_ssl "$NEW_DOMAIN"
    fi

    read -rp "Selesai. Tekan Enter untuk melanjutkan..."
}

# 4. Setup / Fix SSL Certificate
setup_ssl() {
    TARGET_DOMAIN="$1"
    if [ -z "$TARGET_DOMAIN" ]; then
        show_banner
        echo -e "${C_BOLD}PASANG / PERBAIKI SERTIFIKAT SSL (HTTPS):${C_RESET}"
        echo ""
        CURRENT_URL=$(grep -E '^APP_URL=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- | tr -d '"' | tr -d "'" || echo "")
        EXTRACTED_DOMAIN=$(echo "$CURRENT_URL" | sed -e 's|^[^/]*//||' -e 's|/.*$||' -e 's|:.*$||')
        read -rp "Masukkan nama domain untuk sertifikat SSL [$EXTRACTED_DOMAIN]: " INPUT_DOMAIN
        TARGET_DOMAIN="${INPUT_DOMAIN:-$EXTRACTED_DOMAIN}"
    fi

    if [ -z "$TARGET_DOMAIN" ]; then
        echo -e "${C_RED}Domain tidak valid.${C_RESET}"
        read -rp "Tekan Enter untuk melanjutkan..."
        return
    fi

    read -rp "Masukkan email admin untuk notifikasi Let's Encrypt: " SSL_EMAIL
    SSL_EMAIL="${SSL_EMAIL:-admin@$TARGET_DOMAIN}"

    echo -e "${C_YELLOW}Memproses sertifikat Let's Encrypt untuk $TARGET_DOMAIN...${C_RESET}"

    if ! command -v certbot &>/dev/null; then
        echo -e "${C_YELLOW}Certbot belum terpasang. Memasang certbot...${C_RESET}"
        apt-get update -y && apt-get install -y certbot python3-certbot-nginx
    fi

    if certbot --nginx -d "$TARGET_DOMAIN" --non-interactive --agree-tos -m "$SSL_EMAIL" --redirect; then
        echo -e "${C_GREEN}SSL HTTPS berhasil diterbitkan dan dipasang ke Nginx!${C_RESET}"
        # Update .env to https
        if [ -f "$ENV_FILE" ]; then
            sed -i -E "s|^APP_URL=http://|APP_URL=https://|" "$ENV_FILE"
            php "$APP_DIR/artisan" config:clear >/dev/null 2>&1 || true
        fi
        systemctl reload nginx
    else
        echo -e "${C_RED}Gagal menerbitkan sertifikat SSL. Pastikan domain $TARGET_DOMAIN sudah mengarah (DNS A record) ke IP VPS ini.${C_RESET}"
    fi

    if [ -z "$1" ]; then
        read -rp "Tekan Enter untuk melanjutkan..."
    fi
}

# 5. Update via GitHub Repository
update_git() {
    show_banner
    echo -e "${C_BOLD}UPDATE APLIKASI DARI REPOSITORI GITHUB:${C_RESET}"
    echo ""
    read -rp "Mulai proses update git sekarang? (y/n): " confirm_update
    if [[ ! "$confirm_update" =~ ^[Yy]$ ]]; then
        return
    fi

    echo -e "${C_YELLOW}[1/6] Mengaktifkan Mode Pemeliharaan...${C_RESET}"
    php "$APP_DIR/artisan" down --render="errors::503" 2>/dev/null || true

    echo -e "${C_YELLOW}[2/6] Mengambil kode terbaru dari GitHub (git pull)...${C_RESET}"
    if [ -d "$APP_DIR/.git" ]; then
        git -C "$APP_DIR" fetch --all
        git -C "$APP_DIR" reset --hard origin/main || git -C "$APP_DIR" pull
    else
        echo -e "${C_RED}Direktori .git tidak ditemukan di $APP_DIR.${C_RESET}"
    fi

    echo -e "${C_YELLOW}[3/6] Memperbarui dependensi Composer...${C_RESET}"
    composer install --working-dir="$APP_DIR" --no-dev --optimize-autoloader --no-interaction

    echo -e "${C_YELLOW}[4/6] Menjalankan migrasi database...${C_RESET}"
    php "$APP_DIR/artisan" migrate --force

    echo -e "${C_YELLOW}[5/6] Mengoptimasi cache Laravel...${C_RESET}"
    php "$APP_DIR/artisan" optimize:clear
    php "$APP_DIR/artisan" optimize

    echo -e "${C_YELLOW}[6/6] Mematikan Mode Pemeliharaan & Reload PHP-FPM...${C_RESET}"
    php "$APP_DIR/artisan" up
    systemctl reload "$PHP_FPM_SVC"

    echo ""
    echo -e "${C_GREEN}${C_BOLD}Pembaruan website via GitHub berhasil selesai!${C_RESET}"
    read -rp "Tekan Enter untuk melanjutkan..."
}

# 6. Toggle Maintenance Mode
toggle_maintenance() {
    show_banner
    echo -e "${C_BOLD}MODE PEMELIHARAAN (MAINTENANCE MODE):${C_RESET}"
    echo ""
    if [ -f "$APP_DIR/storage/framework/down" ]; then
        echo -e "Status Saat Ini: ${C_YELLOW}SEDANG AKTIF (Down)${C_RESET}"
        read -rp "Nyalakan website kembali (artisan up)? (y/n): " confirm_up
        if [[ "$confirm_up" =~ ^[Yy]$ ]]; then
            php "$APP_DIR/artisan" up
            echo -e "${C_GREEN}Website telah online kembali.${C_RESET}"
        fi
    else
        echo -e "Status Saat Ini: ${C_GREEN}ONLINE (Normal)${C_RESET}"
        read -rp "Aktifkan maintenance mode sekarang (artisan down)? (y/n): " confirm_down
        if [[ "$confirm_down" =~ ^[Yy]$ ]]; then
            read -rp "Masukkan pesan maintenance (opsional): " custom_msg
            if [ -n "$custom_msg" ]; then
                php "$APP_DIR/artisan" down --message="$custom_msg"
            else
                php "$APP_DIR/artisan" down
            fi
            echo -e "${C_YELLOW}Website sekarang berada dalam mode pemeliharaan.${C_RESET}"
        fi
    fi
    read -rp "Tekan Enter untuk melanjutkan..."
}

# 7. Clear & Optimize Cache
optimize_cache() {
    show_banner
    echo -e "${C_BOLD}OPTIMASI & CACHE MANAGEMENT:${C_RESET}"
    echo ""
    echo -e "${C_YELLOW}Membersihkan dan mengompilasi cache Laravel...${C_RESET}"
    php "$APP_DIR/artisan" optimize:clear
    php "$APP_DIR/artisan" config:cache
    php "$APP_DIR/artisan" route:cache
    php "$APP_DIR/artisan" view:cache
    echo ""
    echo -e "${C_GREEN}Cache konfigurasi, route, dan view berhasil dioptimalkan!${C_RESET}"
    read -rp "Tekan Enter untuk melanjutkan..."
}

# 8. Backup Database
backup_database() {
    show_banner
    echo -e "${C_BOLD}PENCADANGAN DATABASE (BACKUP DUMP):${C_RESET}"
    echo ""

    BACKUP_DIR="$APP_DIR/storage/backups"
    mkdir -p "$BACKUP_DIR"

    # Extract DB credentials from .env
    DB_NAME=$(grep -E '^DB_DATABASE=' "$ENV_FILE" | cut -d= -f2- | tr -d '"' | tr -d "'")
    DB_USER=$(grep -E '^DB_USERNAME=' "$ENV_FILE" | cut -d= -f2- | tr -d '"' | tr -d "'")
    DB_PASS=$(grep -E '^DB_PASSWORD=' "$ENV_FILE" | cut -d= -f2- | tr -d '"' | tr -d "'")
    DB_HOST=$(grep -E '^DB_HOST=' "$ENV_FILE" | cut -d= -f2- | tr -d '"' | tr -d "'")

    TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    FILE_NAME="backup_${DB_NAME}_${TIMESTAMP}.sql.gz"
    FULL_PATH="$BACKUP_DIR/$FILE_NAME"

    echo -e "Menyimpan database ${C_CYAN}$DB_NAME${C_RESET}..."

    PASS_ARG=""
    if [ -n "$DB_PASS" ]; then
        PASS_ARG="-p$DB_PASS"
    fi

    if mysqldump -h "${DB_HOST:-127.0.0.1}" -u "$DB_USER" $PASS_ARG "$DB_NAME" | gzip > "$FULL_PATH"; then
        FILE_SIZE=$(du -h "$FULL_PATH" | cut -f1)
        echo -e "${C_GREEN}Backup berhasil dibuat:${C_RESET}"
        echo -e "  File : ${C_WHITE}$FULL_PATH${C_RESET}"
        echo -e "  Ukuran: ${C_WHITE}$FILE_SIZE${C_RESET}"
    else
        echo -e "${C_RED}Gagal mencadangkan database. Periksa kredensial .env.${C_RESET}"
    fi

    read -rp "Tekan Enter untuk melanjutkan..."
}

# 9. Restore Database
restore_database() {
    show_banner
    echo -e "${C_BOLD}PEMULIHAN DATABASE (RESTORE FROM BACKUP):${C_RESET}"
    echo ""
    BACKUP_DIR="$APP_DIR/storage/backups"

    if [ ! -d "$BACKUP_DIR" ] || [ -z "$(ls -A "$BACKUP_DIR"/*.sql.gz 2>/dev/null)" ]; then
        echo -e "${C_YELLOW}Tidak ada file backup (.sql.gz) di folder $BACKUP_DIR.${C_RESET}"
        read -rp "Tekan Enter untuk melanjutkan..."
        return
    fi

    echo "Pilih file backup yang akan dipulihkan:"
    FILES=("$BACKUP_DIR"/*.sql.gz)
    for i in "${!FILES[@]}"; do
        F_NAME=$(basename "${FILES[$i]}")
        F_SIZE=$(du -h "${FILES[$i]}" | cut -f1)
        echo "  $((i+1))) $F_NAME ($F_SIZE)"
    done
    echo "  0) Batal"
    echo ""
    read -rp "Nomor pilihan [1-${#FILES[@]}]: " pick

    if [ "$pick" -ge 1 ] && [ "$pick" -le "${#FILES[@]}" ] 2>/dev/null; then
        CHOSEN_FILE="${FILES[$((pick-1))]}"
        echo ""
        echo -e "${C_RED}${C_BOLD}PERINGATAN: Memulihkan database akan menimpa seluruh data yang ada saat ini!${C_RESET}"
        read -rp "Ketik 'SAYA YAKIN' untuk melanjutkan restore: " confirm_res

        if [ "$confirm_res" = "SAYA YAKIN" ]; then
            DB_NAME=$(grep -E '^DB_DATABASE=' "$ENV_FILE" | cut -d= -f2- | tr -d '"' | tr -d "'")
            DB_USER=$(grep -E '^DB_USERNAME=' "$ENV_FILE" | cut -d= -f2- | tr -d '"' | tr -d "'")
            DB_PASS=$(grep -E '^DB_PASSWORD=' "$ENV_FILE" | cut -d= -f2- | tr -d '"' | tr -d "'")
            DB_HOST=$(grep -E '^DB_HOST=' "$ENV_FILE" | cut -d= -f2- | tr -d '"' | tr -d "'")

            PASS_ARG=""
            if [ -n "$DB_PASS" ]; then PASS_ARG="-p$DB_PASS"; fi

            echo -e "${C_YELLOW}Memulihkan data dari $(basename "$CHOSEN_FILE")...${C_RESET}"
            if gunzip -c "$CHOSEN_FILE" | mysql -h "${DB_HOST:-127.0.0.1}" -u "$DB_USER" $PASS_ARG "$DB_NAME"; then
                echo -e "${C_GREEN}Database berhasil dipulihkan!${C_RESET}"
            else
                echo -e "${C_RED}Gagal memulihkan database.${C_RESET}"
            fi
        else
            echo "Pemulihan dibatalkan."
        fi
    fi
    read -rp "Tekan Enter untuk melanjutkan..."
}

# 10. Low-RAM System Tuning
apply_tuning() {
    show_banner
    echo -e "${C_BOLD}APLIKASIKAN TUNING MEMORI RENDAH (1GB RAM):${C_RESET}"
    echo ""
    echo "1. Menyiapkan Swap 2GB (jika belum aktif)..."
    if [ "$(free -m | awk '/^Swap:/{print $2}')" -lt 1000 ]; then
        if [ ! -f /swapfile ]; then
            fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
            chmod 600 /swapfile
            mkswap /swapfile
            swapon /swapfile
            echo '/swapfile none swap sw 0 0' >> /etc/fstab
            echo -e "${C_GREEN}Swap 2GB berhasil diaktifkan.${C_RESET}"
        fi
    else
        echo -e "${C_GREEN}Swap sudah cukup (${SWAP_TOTAL} MB).${C_RESET}"
    fi

    echo "2. Menerapkan tuning kernel (swappiness & cache pressure)..."
    sysctl vm.swappiness=10
    sysctl vm.vfs_cache_pressure=50
    grep -q "vm.swappiness" /etc/sysctl.conf || echo "vm.swappiness=10" >> /etc/sysctl.conf
    grep -q "vm.vfs_cache_pressure" /etc/sysctl.conf || echo "vm.vfs_cache_pressure=50" >> /etc/sysctl.conf

    echo "3. Menerapkan template low-ram MySQL/MariaDB..."
    if [ -f "$SCRIPT_DIR/mysql/low-ram.cnf" ]; then
        cp "$SCRIPT_DIR/mysql/low-ram.cnf" /etc/mysql/conf.d/teraskota-low-ram.cnf 2>/dev/null || \
        cp "$SCRIPT_DIR/mysql/low-ram.cnf" /etc/mysql/mariadb.conf.d/99-teraskota-low-ram.cnf 2>/dev/null || true
        systemctl restart "$DB_SVC" 2>/dev/null || true
        echo -e "${C_GREEN}Konfigurasi low-ram database diterapkan.${C_RESET}"
    fi

    echo ""
    echo -e "${C_GREEN}${C_BOLD}Tuning sistem 1GB RAM berhasil selesai!${C_RESET}"
    read -rp "Tekan Enter untuk melanjutkan..."
}

# Main Interactive Menu Loop
interactive_menu() {
    while true; do
        show_info
        echo -e "${C_BOLD}MENU MANAJEMEN TERAS KOTA:${C_RESET}"
        echo "  1. Informasi & Status Lengkap Sistem (System Health)"
        echo "  2. Kelola Layanan (Start / Stop / Restart Nginx, PHP, DB)"
        echo "  3. Ubah Domain Website (Change Domain Nginx + .env)"
        echo "  4. Pasang / Perbaiki Sertifikat SSL (Let's Encrypt)"
        echo "  5. Update Aplikasi via GitHub (Pull + Migrate + Optimize)"
        echo "  6. Mode Pemeliharaan (Maintenance Mode ON / OFF)"
        echo "  7. Bersihkan Cache & Optimasi Laravel (Clear / Cache)"
        echo "  8. Cadangkan Database (Backup Dump SQL)"
        echo "  9. Pulihkan Database (Restore from Backup)"
        echo " 10. Tuning Memori Rendah (1GB RAM Optimization)"
        echo "  0. Keluar"
        echo "================================================================================"
        read -rp "Pilih menu [0-10]: " choice

        case "$choice" in
            1) show_info; read -rp "Tekan Enter untuk kembali ke menu..." ;;
            2) manage_services ;;
            3) change_domain ;;
            4) setup_ssl ;;
            5) update_git ;;
            6) toggle_maintenance ;;
            7) optimize_cache ;;
            8) backup_database ;;
            9) restore_database ;;
            10) apply_tuning ;;
            0|q|exit) echo -e "${C_GREEN}Sampai jumpa!${C_RESET}"; exit 0 ;;
            *) echo -e "${C_RED}Pilihan tidak valid.${C_RESET}"; sleep 1 ;;
        esac
    done
}

# CLI Argument Routing
case "$1" in
    status|info)
        show_info
        ;;
    restart)
        case "$2" in
            nginx) systemctl restart nginx ;;
            php) systemctl restart "$PHP_FPM_SVC" ;;
            db) systemctl restart "$DB_SVC" ;;
            *) systemctl restart nginx "$PHP_FPM_SVC" "$DB_SVC" ;;
        esac
        ;;
    update)
        update_git
        ;;
    ssl)
        setup_ssl "$2"
        ;;
    backup)
        backup_database
        ;;
    cache)
        optimize_cache
        ;;
    *)
        interactive_menu
        ;;
esac
