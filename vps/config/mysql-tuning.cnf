# Teras Kota — MariaDB/MySQL tuning for 1GB RAM VPS
# Placed at: /etc/mysql/mariadb.conf.d/99-teraskota.cnf
# Or:        /etc/mysql/mysql.conf.d/99-teraskota.cnf

[mysqld]
# ── InnoDB ────────────────────────────────────────────────────────────────────
innodb_buffer_pool_size = 128M
innodb_log_file_size    = 32M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method     = O_DIRECT

# ── Connections ───────────────────────────────────────────────────────────────
max_connections         = 30
wait_timeout            = 300
interactive_timeout     = 300

# ── Cache ─────────────────────────────────────────────────────────────────────
key_buffer_size         = 16M
table_open_cache        = 200
table_definition_cache  = 200
tmp_table_size          = 16M
max_heap_table_size     = 16M

# ── Logging ───────────────────────────────────────────────────────────────────
slow_query_log          = 1
slow_query_log_file     = /var/log/mysql/slow-queries.log
long_query_time         = 2

# ── Safety ────────────────────────────────────────────────────────────────────
max_allowed_packet      = 16M
# skip_name_resolve     = 1  # Disabled to avoid 1130 host issues on loopback/localhost

# ── Character Set ─────────────────────────────────────────────────────────────
character_set_server    = utf8mb4
collation_server        = utf8mb4_unicode_ci
