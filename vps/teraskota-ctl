#!/usr/bin/env bash
# language: bash, file: vps/teraskota-ctl, target: Ubuntu 24/26 x86_64/arm64
# Teras Kota — Terminal Control Panel
# Usage: sudo teraskota-ctl              (interactive menu)
#        sudo teraskota-ctl <command>     (direct command)

set -euo pipefail

# ── Source common functions ───────────────────────────────────────────────────
# When installed, lib is at the repo root. When running standalone, look in known locations.
for search_dir in \
    "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib" \
    "/var/www/teraskota/vps/lib" \
    "/opt/teraskota/lib"; do
    if [ -f "${search_dir}/common.sh" ]; then
        source "${search_dir}/common.sh"
        break
    fi
done

# Verify common.sh loaded
if ! declare -f log_info &>/dev/null; then
    echo "ERROR: common.sh not found. Is Teras Kota installed?" >&2
    exit 1
fi

require_root

# ── Load config ───────────────────────────────────────────────────────────────
DOMAIN=$(load_config "DOMAIN" "localhost")
PHP_VER=$(load_config "PHP_VERSION" "8.3")
DB_NAME=$(load_config "DB_NAME" "db_teras_kota")
DB_USER=$(load_config "DB_USER" "teraskota")
DB_PASS=$(cat "${TERASKOTA_CONFIG}/db_password" 2>/dev/null || echo "")
REPO_BRANCH=$(load_config "REPO_BRANCH" "main")

# ── Service names ─────────────────────────────────────────────────────────────
SVC_PHP="php${PHP_VER}-fpm"
SVC_NGINX="nginx"
SVC_DB="mariadb"

# ══════════════════════════════════════════════════════════════════════════════
# COMMANDS
# ══════════════════════════════════════════════════════════════════════════════

cmd_status() {
    echo
    echo -e "${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║         TERAS KOTA — STATUS                     ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════╝${C_RESET}"
    echo

    # Services
    echo -e "${C_BOLD}Services:${C_RESET}"
    echo -e "  $(service_status "$SVC_NGINX")"
    echo -e "  $(service_status "$SVC_PHP")"
    echo -e "  $(service_status "$SVC_DB")"
    echo

    # Website info
    echo -e "${C_BOLD}Website:${C_RESET}"
    echo -e "  Domain     : ${C_GREEN}${DOMAIN}${C_RESET}"
    echo -e "  URL        : ${C_GREEN}https://${DOMAIN}${C_RESET}"
    echo -e "  Root       : ${TERASKOTA_ROOT}"
    echo -e "  PHP        : ${PHP_VER}"
    echo -e "  Database   : ${DB_NAME}"
    echo

    # SSL status
    echo -e "${C_BOLD}SSL Certificate:${C_RESET}"
    if [ -d "/etc/letsencrypt/live/${DOMAIN}" ]; then
        local expiry
        expiry=$(openssl x509 -enddate -noout -in "/etc/letsencrypt/live/${DOMAIN}/fullchain.pem" 2>/dev/null | cut -d= -f2)
        echo -e "  Status     : ${C_GREEN}Active${C_RESET}"
        echo -e "  Expires    : ${expiry}"
    else
        echo -e "  Status     : ${C_YELLOW}Not configured${C_RESET}"
    fi
    echo

    # System resources
    echo -e "${C_BOLD}Resources:${C_RESET}"
    local ram_used ram_total ram_pct
    ram_total=$(free -m | awk '/Mem:/ {print $2}')
    ram_used=$(free -m | awk '/Mem:/ {print $3}')
    ram_pct=$((ram_used * 100 / ram_total))
    echo -e "  RAM        : ${ram_used}/${ram_total} MB (${ram_pct}%)"

    local disk_used disk_total disk_pct
    disk_total=$(df -BG / | awk 'NR==2 {gsub("G",""); print $2}')
    disk_used=$(df -BG / | awk 'NR==2 {gsub("G",""); print $3}')
    disk_pct=$(df / | awk 'NR==2 {print $5}')
    echo -e "  Disk       : ${disk_used}/${disk_total} GB (${disk_pct})"

    local swap_total
    swap_total=$(free -m | awk '/Swap:/ {print $2}')
    echo -e "  Swap       : ${swap_total} MB"

    echo -e "  Uptime     : $(uptime -p)"
    echo

    # Last backup
    echo -e "${C_BOLD}Backup:${C_RESET}"
    local last_backup
    last_backup=$(ls -t "${TERASKOTA_BACKUP_DIR}"/db_*.sql.gz 2>/dev/null | head -1)
    if [ -n "$last_backup" ]; then
        local backup_size
        backup_size=$(du -sh "$last_backup" | cut -f1)
        echo -e "  Last       : $(basename "$last_backup") (${backup_size})"
        echo -e "  Count      : $(ls "${TERASKOTA_BACKUP_DIR}"/db_*.sql.gz 2>/dev/null | wc -l) files"
    else
        echo -e "  Last       : ${C_YELLOW}No backups found${C_RESET}"
    fi
    echo
}

cmd_start() {
    log_info "Starting all services..."
    service_action start "$SVC_DB"
    service_action start "$SVC_PHP"
    service_action start "$SVC_NGINX"
    log_ok "All services started"
}

cmd_stop() {
    log_info "Stopping all services..."
    service_action stop "$SVC_NGINX"
    service_action stop "$SVC_PHP"
    service_action stop "$SVC_DB"
    log_ok "All services stopped"
}

cmd_restart() {
    log_info "Restarting all services..."
    service_action restart "$SVC_DB"
    service_action restart "$SVC_PHP"
    service_action restart "$SVC_NGINX"
    log_ok "All services restarted"
}

cmd_change_domain() {
    local new_domain
    new_domain=$(prompt_input "Change Domain" "Domain baru" "$DOMAIN")

    if [ -z "$new_domain" ] || [ "$new_domain" = "$DOMAIN" ]; then
        log_info "Domain tidak berubah"
        return 0
    fi

    log_info "Mengubah domain: ${DOMAIN} → ${new_domain}"

    # 1. Update nginx config
    local vhost="/etc/nginx/sites-available/teraskota"
    if [ -f "$vhost" ]; then
        sed -i "s/server_name ${DOMAIN}/server_name ${new_domain}/" "$vhost"
        log_ok "Nginx config updated"
    fi

    # 2. Update .env
    local env_file="${TERASKOTA_ROOT}/.env"
    if [ -f "$env_file" ]; then
        sed -i "s|APP_URL=.*|APP_URL=https://${new_domain}|" "$env_file"
        cd "${TERASKOTA_ROOT}"
        php artisan config:cache 2>/dev/null
        log_ok ".env updated"
    fi

    # 3. Update config
    save_config "DOMAIN" "$new_domain"
    DOMAIN="$new_domain"

    # 4. Test & reload nginx
    if nginx -t 2>&1; then
        systemctl reload nginx
        log_ok "Nginx reloaded"
    else
        log_error "Nginx config test gagal — rollback manual diperlukan"
        return 1
    fi

    # 5. Request new SSL
    if prompt_yesno "SSL" "Request SSL certificate untuk ${new_domain}?"; then
        cmd_fix_ssl
    fi

    log_ok "Domain berhasil diubah ke: ${new_domain}"
}

cmd_fix_ssl() {
    log_info "Memperbarui SSL certificate untuk ${DOMAIN}..."

    local email
    email=$(load_config "SSL_EMAIL" "")

    local certbot_cmd=(certbot --nginx -d "$DOMAIN" --non-interactive --agree-tos)
    if [ -n "$email" ]; then
        certbot_cmd+=(--email "$email")
    else
        certbot_cmd+=(--register-unsafely-without-email)
    fi

    if "${certbot_cmd[@]}" 2>&1; then
        systemctl reload nginx
        log_ok "SSL certificate berhasil diperbarui"
    else
        log_error "SSL gagal — pastikan DNS ${DOMAIN} sudah pointing ke server ini"
        echo -e "${C_DIM}Cek: dig +short ${DOMAIN}${C_RESET}"
    fi
}

cmd_update() {
    log_info "Updating Teras Kota dari GitHub..."

    git config --global --add safe.directory "${TERASKOTA_ROOT}" 2>/dev/null || true
    git config --system --add safe.directory "${TERASKOTA_ROOT}" 2>/dev/null || true
    export COMPOSER_ALLOW_SUPERUSER=1

    cd "${TERASKOTA_ROOT}"

    # Stash any local changes
    git stash 2>/dev/null || true

    # Pull
    log_substep "git pull origin ${REPO_BRANCH}..."
    if ! git pull origin "$REPO_BRANCH" 2>&1; then
        log_error "git pull gagal"
        return 1
    fi

    # Composer
    log_substep "composer install..."
    composer install --no-dev --optimize-autoloader --no-interaction 2>&1 | tail -5

    # Node build (if package.json changed or build dir missing)
    if [ ! -d "${TERASKOTA_ROOT}/public/build" ] || git diff HEAD~1 --name-only 2>/dev/null | grep -q "package"; then
        log_substep "Rebuilding assets..."
        if check_command node; then
            npm ci 2>&1 | tail -3
            npm run build 2>&1 | tail -3
            rm -rf node_modules
            log_ok "Assets rebuilt"
        else
            log_warn "Node.js tidak tersedia — skip asset build"
        fi
    fi

    # Migrate
    log_substep "Running migrations..."
    php artisan migrate --force 2>&1

    # Clear & re-cache
    php artisan config:cache
    php artisan route:cache
    php artisan view:cache

    # Permissions
    chown -R www-data:www-data "${TERASKOTA_ROOT}"

    # Restart PHP-FPM (OPcache clear)
    systemctl restart "$SVC_PHP"
    systemctl reload "$SVC_NGINX"

    log_ok "Update selesai"
}

cmd_backup() {
    log_info "Membuat backup database..."

    mkdir -p "${TERASKOTA_BACKUP_DIR}"
    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S)
    local backup_file="${TERASKOTA_BACKUP_DIR}/db_${timestamp}.sql.gz"

    mysqldump -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" 2>/dev/null | gzip > "$backup_file"

    if [ -f "$backup_file" ]; then
        local size
        size=$(du -sh "$backup_file" | cut -f1)
        log_ok "Backup: ${backup_file} (${size})"
    else
        log_error "Backup gagal"
    fi
}

cmd_restore() {
    log_info "Daftar backup tersedia:"
    echo

    local backups=()
    local i=0
    while IFS= read -r f; do
        i=$((i + 1))
        local size
        size=$(du -sh "$f" | cut -f1)
        local fname
        fname=$(basename "$f")
        echo -e "  ${C_CYAN}${i}${C_RESET}) ${fname} (${size})"
        backups+=("$f")
    done < <(ls -t "${TERASKOTA_BACKUP_DIR}"/db_*.sql.gz 2>/dev/null)

    if [ ${#backups[@]} -eq 0 ]; then
        log_warn "Tidak ada backup tersedia"
        return 0
    fi

    echo
    local choice
    read -rp "$(echo -e "${C_CYAN}Pilih nomor backup (0 = batal):${C_RESET} ")" choice

    if [ "$choice" = "0" ] || [ -z "$choice" ]; then
        log_info "Restore dibatalkan"
        return 0
    fi

    local idx=$((choice - 1))
    if [ $idx -lt 0 ] || [ $idx -ge ${#backups[@]} ]; then
        log_error "Pilihan tidak valid"
        return 1
    fi

    local selected="${backups[$idx]}"

    if prompt_yesno "Konfirmasi" "RESTORE database dari $(basename "$selected")? Data saat ini akan ditimpa."; then
        log_info "Restoring..."
        gunzip -c "$selected" | mysql -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" 2>/dev/null
        log_ok "Database restored dari $(basename "$selected")"
    else
        log_info "Restore dibatalkan"
    fi
}

cmd_logs() {
    echo -e "${C_BOLD}Pilih log:${C_RESET}"
    echo -e "  ${C_CYAN}1${C_RESET}) Laravel (storage/logs/laravel.log)"
    echo -e "  ${C_CYAN}2${C_RESET}) Nginx Access"
    echo -e "  ${C_CYAN}3${C_RESET}) Nginx Error"
    echo -e "  ${C_CYAN}4${C_RESET}) PHP-FPM"
    echo -e "  ${C_CYAN}5${C_RESET}) MariaDB"
    echo -e "  ${C_CYAN}0${C_RESET}) Kembali"
    echo

    local choice
    read -rp "$(echo -e "${C_CYAN}Pilihan:${C_RESET} ")" choice

    case "$choice" in
        1) tail -f "${TERASKOTA_ROOT}/storage/logs/laravel.log" ;;
        2) tail -f /var/log/nginx/teraskota-access.log ;;
        3) tail -f /var/log/nginx/teraskota-error.log ;;
        4) journalctl -fu "$SVC_PHP" ;;
        5) journalctl -fu "$SVC_DB" ;;
        0) return 0 ;;
        *) log_warn "Pilihan tidak valid" ;;
    esac
}

cmd_help() {
    echo -e "${C_BOLD}Usage:${C_RESET} teraskota-ctl [command]"
    echo
    echo -e "${C_BOLD}Commands:${C_RESET}"
    echo -e "  status          Tampilkan status services, website, dan resources"
    echo -e "  start           Start semua services"
    echo -e "  stop            Stop semua services"
    echo -e "  restart         Restart semua services"
    echo -e "  domain          Ubah domain website"
    echo -e "  ssl             Fix/renew SSL certificate"
    echo -e "  update          Update dari GitHub repository"
    echo -e "  backup          Backup database"
    echo -e "  restore         Restore database dari backup"
    echo -e "  logs            Lihat log files (tail -f)"
    echo -e "  help            Tampilkan bantuan ini"
    echo
    echo -e "Tanpa argumen, menampilkan menu interaktif."
}

# ══════════════════════════════════════════════════════════════════════════════
# INTERACTIVE MENU
# ══════════════════════════════════════════════════════════════════════════════
interactive_menu() {
    while true; do
        echo
        echo -e "${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════╗${C_RESET}"
        echo -e "${C_BOLD}${C_CYAN}║         TERAS KOTA CONTROL PANEL                ║${C_RESET}"
        echo -e "${C_BOLD}${C_CYAN}╠══════════════════════════════════════════════════╣${C_RESET}"
        echo -e "${C_BOLD}${C_CYAN}║${C_RESET}  ${C_WHITE}1.${C_RESET} Status              ${C_DIM}(info service)${C_RESET}       ${C_BOLD}${C_CYAN}║${C_RESET}"
        echo -e "${C_BOLD}${C_CYAN}║${C_RESET}  ${C_WHITE}2.${C_RESET} Start               ${C_DIM}(all services)${C_RESET}       ${C_BOLD}${C_CYAN}║${C_RESET}"
        echo -e "${C_BOLD}${C_CYAN}║${C_RESET}  ${C_WHITE}3.${C_RESET} Stop                ${C_DIM}(all services)${C_RESET}       ${C_BOLD}${C_CYAN}║${C_RESET}"
        echo -e "${C_BOLD}${C_CYAN}║${C_RESET}  ${C_WHITE}4.${C_RESET} Restart             ${C_DIM}(all services)${C_RESET}       ${C_BOLD}${C_CYAN}║${C_RESET}"
        echo -e "${C_BOLD}${C_CYAN}║${C_RESET}  ${C_WHITE}5.${C_RESET} Change Domain       ${C_DIM}(+ SSL renew)${C_RESET}        ${C_BOLD}${C_CYAN}║${C_RESET}"
        echo -e "${C_BOLD}${C_CYAN}║${C_RESET}  ${C_WHITE}6.${C_RESET} Fix SSL Certificate ${C_DIM}(certbot)${C_RESET}            ${C_BOLD}${C_CYAN}║${C_RESET}"
        echo -e "${C_BOLD}${C_CYAN}║${C_RESET}  ${C_WHITE}7.${C_RESET} Update via GitHub   ${C_DIM}(git pull+build)${C_RESET}     ${C_BOLD}${C_CYAN}║${C_RESET}"
        echo -e "${C_BOLD}${C_CYAN}║${C_RESET}  ${C_WHITE}8.${C_RESET} Database Backup     ${C_DIM}(mysqldump)${C_RESET}          ${C_BOLD}${C_CYAN}║${C_RESET}"
        echo -e "${C_BOLD}${C_CYAN}║${C_RESET}  ${C_WHITE}9.${C_RESET} Database Restore    ${C_DIM}(from backup)${C_RESET}        ${C_BOLD}${C_CYAN}║${C_RESET}"
        echo -e "${C_BOLD}${C_CYAN}║${C_RESET} ${C_WHITE}10.${C_RESET} View Logs           ${C_DIM}(tail -f)${C_RESET}            ${C_BOLD}${C_CYAN}║${C_RESET}"
        echo -e "${C_BOLD}${C_CYAN}║${C_RESET}  ${C_WHITE} 0.${C_RESET} Exit                                       ${C_BOLD}${C_CYAN}║${C_RESET}"
        echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════╝${C_RESET}"
        echo

        local choice
        read -rp "$(echo -e "${C_CYAN}Pilihan [0-10]:${C_RESET} ")" choice

        case "$choice" in
            1)  cmd_status ;;
            2)  cmd_start ;;
            3)  cmd_stop ;;
            4)  cmd_restart ;;
            5)  cmd_change_domain ;;
            6)  cmd_fix_ssl ;;
            7)  cmd_update ;;
            8)  cmd_backup ;;
            9)  cmd_restore ;;
            10) cmd_logs ;;
            0)  echo -e "${C_DIM}Keluar.${C_RESET}"; exit 0 ;;
            *)  log_warn "Pilihan tidak valid: ${choice}" ;;
        esac
    done
}

# ══════════════════════════════════════════════════════════════════════════════
# ENTRYPOINT
# ══════════════════════════════════════════════════════════════════════════════
if [ $# -eq 0 ]; then
    interactive_menu
else
    case "$1" in
        status)   cmd_status ;;
        start)    cmd_start ;;
        stop)     cmd_stop ;;
        restart)  cmd_restart ;;
        domain)   cmd_change_domain ;;
        ssl)      cmd_fix_ssl ;;
        update)   cmd_update ;;
        backup)   cmd_backup ;;
        restore)  cmd_restore ;;
        logs)     cmd_logs ;;
        help|-h|--help) cmd_help ;;
        *) log_error "Unknown command: $1"; cmd_help; exit 1 ;;
    esac
fi
