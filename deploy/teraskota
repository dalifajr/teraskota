    echo "  ╚══██╔══╝██╔════╝██╔══██╗██╔══██╗██╔════╝██║ ██╔╝██╔═══██╗╚══██╔══╝██╔══██╗"
    echo "     ██║   █████╗  ██████╔╝███████║███████╗█████╔╝ ██║   ██║   ██║   ███████║"
    echo "     ██║   ██╔══╝  ██╔══██╗██╔══██║╚════██║██╔═██╗ ██║   ██║   ██║   ██╔══██║"
    echo "     ██║   ███████╗██║  ██║██║  ██║███████║██║  ██╗╚██████╔╝   ██║   ██║  ██║"
