#!/usr/bin/env bash
# ==============================================================================
# Teras Kota POS - Terminal VPS Control Panel & Management CLI
# Compatible with Ubuntu 24.04/26.04 (x86_64 & ARM64/aarch64)
# ==============================================================================

# Determine Application Root Directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/../artisan" ]; then
    APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
elif [ -d "/var/www/teraskota" ]; then
    APP_DIR="/var/www/teraskota"
else
    APP_DIR="$(pwd)"
fi

ENV_FILE="$APP_DIR/.env"
NGINX_CONF="/etc/nginx/sites-available/teraskota.conf"

# Color Codes
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_RED="\033[1;31m"
C_YELLOW="\033[1;33m"
C_BLUE="\033[1;34m"
C_CYAN="\033[1;36m"
C_WHITE="\033[1;37m"
C_GRAY="\033[0;90m"

# Helper: Detect active PHP-FPM service name
get_php_fpm_service() {
    for ver in 8.3 8.2 8.4; do
        if systemctl list-unit-files | grep -q "php${ver}-fpm"; then
            echo "php${ver}-fpm"
            return
        fi
    done
    echo "php-fpm"
}

# Helper: Detect active Database service name
get_db_service() {
    if systemctl is-active --quiet mariadb 2>/dev/null; then
        echo "mariadb"
    elif systemctl is-active --quiet mysql 2>/dev/null; then
        echo "mysql"
    elif systemctl list-unit-files | grep -q "^mariadb\.service"; then
        echo "mariadb"
    else
        echo "mysql"
    fi
}

PHP_FPM_SVC=$(get_php_fpm_service)
DB_SVC=$(get_db_service)

